# /etc/systemd/system/facturacion.service (en EC2 Ubuntu)
[Unit]
Description=API Sistema de Facturacion Flask (Gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/billing-system-backend
EnvironmentFile=/home/ubuntu/billing-system-backend/.env
ExecStart=/home/ubuntu/billing-system-backend/venv/bin/gunicorn --workers 2 --threads 2 --timeout 60 -c /home/ubuntu/billing-system-backend/gunicorn.conf.py wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
