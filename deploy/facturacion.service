# /etc/systemd/system/facturacion.service (en EC2 Ubuntu)
[Unit]
Description=API Sistema de Facturacion Flask (Gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/billing-system-backend
EnvironmentFile=/home/ubuntu/billing-system-backend/.env
ExecStart=/home/ubuntu/billing-system-backend/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 --timeout 60 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
